{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "checkout",
    "namespace": "retail-staging",
    "labels": {
      "app": "checkout",
      "team": "checkout"
    }
  },
  "spec": {
    "replicas": 2,
    "selector": {
      "matchLabels": {
        "app": "checkout",
        "env": "staging"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "checkout",
          "tier": "web",
          "env": "staging"
        }
      },
      "spec": {
        "containers": [
          {
            "name": "checkout",
            "image": "registry.internal/retail/checkout:2.14.1",
            "ports": [
              {
                "name": "http",
                "containerPort": 8080
              },
              {
                "name": "metrics",
                "containerPort": 9090
              }
            ],
            "env": [
              {
                "name": "PAYMENT_PROVIDER_URL",
                "value": "https://psp.staging.internal"
              },
              {
                "name": "LOG_LEVEL",
                "value": "debug"
              }
            ],
            "resources": {
              "requests": {
                "cpu": "250m",
                "memory": "512Mi"
              }
            },
            "livenessProbe": {
              "httpGet": {
                "path": "/healthz",
                "port": "http"
              },
              "periodSeconds": 10
            },
            "readinessProbe": {
              "httpGet": {
                "path": "/ready",
                "port": "http"
              },
              "periodSeconds": 5
            }
          }
        ]
      }
    }
  }
}
