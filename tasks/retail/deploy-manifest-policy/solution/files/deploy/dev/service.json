{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "checkout",
    "namespace": "retail-dev"
  },
  "spec": {
    "selector": {
      "app": "checkout",
      "env": "dev"
    },
    "ports": [
      {
        "name": "http",
        "port": 80,
        "targetPort": "http"
      },
      {
        "name": "metrics",
        "port": 9090,
        "targetPort": "metrics"
      }
    ]
  }
}
