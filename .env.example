# Copy to .env (git-ignored) and fill in. The app refuses to touch any other project.
GEAP_PROJECT=your-gcp-project
# Local mode: the only user ADC identity accepted (tokeninfo email of `gcloud auth application-default login`)
GEAP_IDENTITY=you@example.com
# Emails allowed through IAP on /admin (Cloud Run deployment)
GEAP_ADMIN_EMAILS=you@example.com
# Optional overrides (defaults shown)
# GEAP_IDENTITY_MODE=user              # user | service_account (Cloud Run)
# GEAP_SA_IDENTITY=geap-eval-runner@your-gcp-project.iam.gserviceaccount.com
# GEAP_ARTIFACT_BUCKET=                # set on Cloud Run: artifacts + DB replica bucket
